{
  "name": "UC14 - Reliance On Third-Party Compliance",
  "nodes": [
    {
      "parameters": {
        "path": "third-party-onboarding",
        "httpMethod": "POST"
      },
      "name": "Onboarding Request",
      "type": "n8n-nodes-base.webhook",
      "position": [0, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM reliance_arrangements WHERE third_party_name = {{ $json.third_party_name }};"
      },
      "name": "Verify Third Party Status",
      "type": "n8n-nodes-base.postgres",
      "position": [200, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.regulatory_status }}",
              "operation": "notEqual",
              "value2": "active"
            }
          ]
        }
      },
      "name": "Check Status Active",
      "type": "n8n-nodes-base.if",
      "position": [400, 300],
      "typeVersion": 1
    },
    {
      "parameters": {},
      "name": "Escalate to Compliance",
      "type": "n8n-nodes-base.emailSend",
      "position": [600, 300],
      "typeVersion": 1
    },
    {
      "parameters": {},
      "name": "Log Action",
      "type": "n8n-nodes-base.postgres",
      "position": [800, 300],
      "typeVersion": 1
    }
  ],
  "connections": {
    "Onboarding Request": {
      "main": [
        [
          {
            "node": "Verify Third Party Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Third Party Status": {
      "main": [
        [
          {
            "node": "Check Status Active",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status Active": {
      "main": [
        [
          {
            "node": "Escalate to Compliance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escalate to Compliance": {
      "main": [
        [
          {
            "node": "Log Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
