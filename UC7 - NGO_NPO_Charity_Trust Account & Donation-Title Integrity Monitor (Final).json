        -2000,
        -224
      ],
      "typeVersion": 1,
      "id": "6c66452b-3a9a-4bdb-a565-1ce983cc44c5",
      "notes": "Reg 6 §3: screens governing body member against watchlists (DP/PP) + pep_list, returns a calibrated match_probability, not a guessed number."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *, GREATEST(similarity(lower(entity_name), lower('{{  $('Split In Batches — Per Member').item.json.name}}')), CASE WHEN id_number = '{{ $('Split In Batches — Per Member').item.json.customer_id }}' THEN 1.0 ELSE 0 END) as match_prob, 'fallback_pg_trgm' as source FROM (SELECT entity_name, id_number FROM watchlists UNION ALL SELECT full_name AS entity_name, id_number FROM pep_list) w ORDER BY match_prob DESC LIMIT 1;",
        "additionalFields": {}
      },
      "name": "Fallback — Postgres pg_trgm Match",
      "type": "n8n-nodes-base.postgres",
      "position": [
        -1920,
        192
      ],
      "typeVersion": 1,
      "id": "9553df19-9ea5-435d-a704-8bbc5ed471cf",
      "credentials": {
        "postgres": {
          "id": "CB2wpsuY6SAUV2Zo",
          "name": "Postgres account"
        }
      },
      "notes": "Only reached if ML API call above fails (continueOnFail). Deterministic fuzzy-text fallback per error-handling policy: if ML similarity service is down, default to strict fuzzy/exact match and flag for manual review."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.verdict || ($json.match_prob >= 0.85 ? 'alert' : 'clear') }}",
