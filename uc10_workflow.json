{
  "name": "UC10 - Complex Transaction Reconstruction & Litigation Hold",
  "nodes": [
    {
      "parameters": {
        "path": "litigation-hold-trigger",
        "httpMethod": "POST"
      },
      "name": "Litigation Hold Request",
      "type": "n8n-nodes-base.webhook",
      "position": [0, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT document_id FROM documents WHERE related_id = {{ $json.customer_id }};"
      },
      "name": "Identify Related Documents",
      "type": "n8n-nodes-base.postgres",
      "position": [200, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE documents SET litigation_hold = TRUE WHERE document_id = {{ $json.document_id }};"
      },
      "name": "Apply Litigation Hold",
      "type": "n8n-nodes-base.postgres",
      "position": [400, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM transactions WHERE account_id = {{ $json.account_id }};"
      },
      "name": "Reconstruct Transactions",
      "type": "n8n-nodes-base.postgres",
      "position": [600, 300],
      "typeVersion": 1
    },
    {
      "parameters": {},
      "name": "Format Reconstruction Bundle",
      "type": "n8n-nodes-base.openAi",
      "position": [800, 300],
      "typeVersion": 1
    },
    {
      "parameters": {},
      "name": "Notify Legal Team",
      "type": "n8n-nodes-base.emailSend",
      "position": [1000, 300],
      "typeVersion": 1
    }
  ],
  "connections": {
    "Litigation Hold Request": {
      "main": [
        [
          {
            "node": "Identify Related Documents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Identify Related Documents": {
      "main": [
        [
          {
            "node": "Apply Litigation Hold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apply Litigation Hold": {
      "main": [
        [
          {
            "node": "Reconstruct Transactions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reconstruct Transactions": {
      "main": [
        [
          {
            "node": "Format Reconstruction Bundle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Reconstruction Bundle": {
      "main": [
        [
          {
            "node": "Notify Legal Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
